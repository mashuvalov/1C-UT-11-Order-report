КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РШ_ДобавитьЗакупочнуюЦенуВПодбор()

	ВидЗакупочнойЦены = РШ_НайтиЗакупочныйВидЦены();

	РШ_НастроитьДинамическийСписокЗакупочнойЦены(
		СписокНоменклатура,
		"Справочник.Номенклатура",
		Ложь,
		ВидЗакупочнойЦены);

	РШ_НастроитьДинамическийСписокЗакупочнойЦены(
		СписокХарактеристики,
		"Справочник.ХарактеристикиНоменклатуры",
		Истина,
		ВидЗакупочнойЦены);

	РШ_ДобавитьКолонкиЗакупочнойЦены();

КонецПроцедуры

&НаСервере
Процедура РШ_НастроитьДинамическийСписокЗакупочнойЦены(
		ДинамическийСписок,
		ОсновнаяТаблица,
		ЭтоСписокХарактеристик,
		ВидЗакупочнойЦены)

	Если ДинамическийСписок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса = ДинамическийСписок.ТекстЗапроса;
	НовыйТекстЗапроса = РШ_ТекстЗапросаСЗакупочнойЦеной(ТекстЗапроса, ЭтоСписокХарактеристик);

	Если НовыйТекстЗапроса <> ТекстЗапроса Тогда
		ДинамическийСписок.ТекстЗапроса = НовыйТекстЗапроса;
	КонецЕсли;

	// После изменения текста запроса платформа сбрасывает основную таблицу динамического списка.
	ДинамическийСписок.ОсновнаяТаблица = ОсновнаяТаблица;

	РШ_УстановитьПараметрДинамическогоСписка(ДинамическийСписок, "ВидЗакупочнойЦены", ВидЗакупочнойЦены);
	РШ_УстановитьПараметрДинамическогоСписка(ДинамическийСписок, "ДатаЗакупочнойЦены", РШ_ДатаЗакупочнойЦены());

	Попытка
		ДинамическийСписок.УстановитьОбязательноеИспользование("ЗакупочнаяЦена", Истина);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция РШ_ДатаЗакупочнойЦены()

	Попытка
		Если ЗначениеЗаполнено(Дата) Тогда
			Возврат Дата;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ТекущаяДата();

КонецФункции

&НаСервере
Процедура РШ_УстановитьПараметрДинамическогоСписка(ДинамическийСписок, ИмяПараметра, ЗначениеПараметра)

	Попытка
		ПодборТоваровКлиентСервер.УстановитьПараметрДинамическогоСписка(
			ДинамическийСписок,
			ИмяПараметра,
			ЗначениеПараметра);
		Возврат;
	Исключение
	КонецПопытки;

	Попытка
		ДинамическийСписок.Параметры.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция РШ_ТекстЗапросаСЗакупочнойЦеной(ТекстЗапроса, ЭтоСписокХарактеристик)

	Если ПустаяСтрока(ТекстЗапроса)
		Или СтрНайти(ТекстЗапроса, "ЗакупочнаяЦена") > 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ЧастиПакета = РШ_РазделитьПакетЗапроса(ТекстЗапроса);
	ОсновнойТекстЗапроса = ЧастиПакета.ОсновнойТекстЗапроса;
	ИспользуетсяЦенообразование25 = СтрНайти(ОсновнойТекстЗапроса, "ЦеныНоменклатуры25") > 0;

	ОсновнойТекстЗапросаСПолем = РШ_ДобавитьПолеЗакупочнойЦены(ОсновнойТекстЗапроса);
	Если ОсновнойТекстЗапросаСПолем = ОсновнойТекстЗапроса Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	ОсновнойТекстЗапросаССоединением = РШ_ДобавитьСоединениеЗакупочныхЦен(
		ОсновнойТекстЗапросаСПолем,
		ЭтоСписокХарактеристик,
		ИспользуетсяЦенообразование25);

	Если ОсновнойТекстЗапросаССоединением = ОсновнойТекстЗапросаСПолем Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;

	Возврат ЧастиПакета.ПрефиксПакетаЗапроса + ОсновнойТекстЗапросаССоединением;

КонецФункции

&НаСервере
Функция РШ_РазделитьПакетЗапроса(ТекстЗапроса)

	Результат = Новый Структура("ПрефиксПакетаЗапроса, ОсновнойТекстЗапроса", "", ТекстЗапроса);
	РазделительПакета = ОбщегоНазначения.РазделительПакетаЗапросов();
	ПозицияРазделителя = РШ_ПоследнееВхождение(ТекстЗапроса, РазделительПакета);

	Если ПозицияРазделителя = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПозицияОсновногоЗапроса = ПозицияРазделителя + СтрДлина(РазделительПакета);
	Результат.ПрефиксПакетаЗапроса = Лев(ТекстЗапроса, ПозицияОсновногоЗапроса - 1);
	Результат.ОсновнойТекстЗапроса = СокрЛП(Сред(ТекстЗапроса, ПозицияОсновногоЗапроса));

	Возврат Результат;

КонецФункции

&НаСервере
Функция РШ_ДобавитьПолеЗакупочнойЦены(ОсновнойТекстЗапроса)

	ПозицияСтрокиИз = РШ_ПозицияСтрокиСлово(ОсновнойТекстЗапроса, "ИЗ");
	Если ПозицияСтрокиИз = 0 Тогда
		Возврат ОсновнойТекстЗапроса;
	КонецЕсли;

	ПолеЗакупочнойЦены =
		"," + Символы.ПС
		+ "	ЕСТЬNULL(ЗакупочныеЦеныНоменклатуры.Цена, 0) КАК ЗакупочнаяЦена";

	Возврат Лев(ОсновнойТекстЗапроса, ПозицияСтрокиИз - 1)
		+ ПолеЗакупочнойЦены
		+ Символы.ПС
		+ Сред(ОсновнойТекстЗапроса, ПозицияСтрокиИз);

КонецФункции

&НаСервере
Функция РШ_ДобавитьСоединениеЗакупочныхЦен(ОсновнойТекстЗапроса, ЭтоСписокХарактеристик, ИспользуетсяЦенообразование25)

	Если ЭтоСписокХарактеристик Тогда
		МаркерОсновнойТаблицы = "Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры";
	Иначе
		МаркерОсновнойТаблицы = "Справочник.Номенклатура КАК СправочникНоменклатура";
	КонецЕсли;

	ТекстСоединения = Символы.ПС
		+ РШ_ТекстСоединенияЗакупочныхЦен(ЭтоСписокХарактеристик, ИспользуетсяЦенообразование25);

	Возврат РШ_ВставитьПослеПервогоВхождения(
		ОсновнойТекстЗапроса,
		МаркерОсновнойТаблицы,
		ТекстСоединения);

КонецФункции

&НаСервере
Функция РШ_ТекстСоединенияЗакупочныхЦен(ЭтоСписокХарактеристик, ИспользуетсяЦенообразование25)

	Если ИспользуетсяЦенообразование25 Тогда
		Если ЭтоСписокХарактеристик Тогда
			Возврат
			"	ЛЕВОЕ СОЕДИНЕНИЕ
			|		(ВЫБРАТЬ
			|			Цены.Номенклатура КАК Номенклатура,
			|			Цены.ХарактеристикаЦО КАК ХарактеристикаЦО,
			|			МАКСИМУМ(Цены.Цена) КАК Цена
			|		ИЗ
			|			РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(&ДатаЗакупочнойЦены,
			|				ВидЦены = &ВидЗакупочнойЦены
			|				И Номенклатура = &Номенклатура
			|				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
			|				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Цены
			|		СГРУППИРОВАТЬ ПО
			|			Цены.Номенклатура,
			|			Цены.ХарактеристикаЦО) КАК ЗакупочныеЦеныНоменклатуры
			|	ПО ЗакупочныеЦеныНоменклатуры.Номенклатура = &Номенклатура
			|		И ЗакупочныеЦеныНоменклатуры.ХарактеристикаЦО =
			|			ВЫБОР
			|				КОГДА ВЫРАЗИТЬ(&ВидНоменклатуры КАК Справочник.ВидыНоменклатуры).НастройкиКлючаЦенПоХарактеристике =
			|					ЗНАЧЕНИЕ(Перечисление.ВариантОтбораДляКлючаЦен.НеИспользовать)
			|					ТОГДА ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
			|				ИНАЧЕ ХарактеристикиНоменклатуры.ХарактеристикаНоменклатурыДляЦенообразования
			|			КОНЕЦ";
		Иначе
			Возврат
			"	ЛЕВОЕ СОЕДИНЕНИЕ
			|		(ВЫБРАТЬ
			|			Цены.Номенклатура КАК Номенклатура,
			|			МАКСИМУМ(Цены.Цена) КАК Цена
			|		ИЗ
			|			РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(&ДатаЗакупочнойЦены,
			|				ВидЦены = &ВидЗакупочнойЦены
			|				И ХарактеристикаЦО = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатурыДляЦенообразования.ПустаяСсылка)
			|				И СерияЦО = ЗНАЧЕНИЕ(Справочник.СерииНоменклатурыДляЦенообразования.ПустаяСсылка)
			|				И УпаковкаЦО = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК Цены
			|		СГРУППИРОВАТЬ ПО
			|			Цены.Номенклатура) КАК ЗакупочныеЦеныНоменклатуры
			|	ПО ЗакупочныеЦеныНоменклатуры.Номенклатура = СправочникНоменклатура.Ссылка";
		КонецЕсли;
	КонецЕсли;

	Если ЭтоСписокХарактеристик Тогда
		Возврат
		"	ЛЕВОЕ СОЕДИНЕНИЕ
		|		(ВЫБРАТЬ
		|			Цены.Номенклатура КАК Номенклатура,
		|			Цены.Характеристика КАК Характеристика,
		|			МАКСИМУМ(Цены.Цена) КАК Цена
		|		ИЗ
		|			РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЗакупочнойЦены,
		|				ВидЦены = &ВидЗакупочнойЦены
		|				И Номенклатура = &Номенклатура) КАК Цены
		|		СГРУППИРОВАТЬ ПО
		|			Цены.Номенклатура,
		|			Цены.Характеристика) КАК ЗакупочныеЦеныНоменклатуры
		|	ПО ЗакупочныеЦеныНоменклатуры.Номенклатура = &Номенклатура
		|		И ЗакупочныеЦеныНоменклатуры.Характеристика = ХарактеристикиНоменклатуры.Ссылка";
	Иначе
		Возврат
		"	ЛЕВОЕ СОЕДИНЕНИЕ
		|		(ВЫБРАТЬ
		|			Цены.Номенклатура КАК Номенклатура,
		|			МАКСИМУМ(Цены.Цена) КАК Цена
		|		ИЗ
		|			РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаЗакупочнойЦены,
		|				ВидЦены = &ВидЗакупочнойЦены
		|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Цены
		|		СГРУППИРОВАТЬ ПО
		|			Цены.Номенклатура) КАК ЗакупочныеЦеныНоменклатуры
		|	ПО ЗакупочныеЦеныНоменклатуры.Номенклатура = СправочникНоменклатура.Ссылка";
	КонецЕсли;

КонецФункции

&НаСервере
Функция РШ_ПозицияСтрокиСлово(Текст, Слово)

	ПереводСтроки = Символы.ПС;
	ДлинаПереводаСтроки = СтрДлина(ПереводСтроки);
	Позиция = 1;

	Пока Позиция <= СтрДлина(Текст) Цикл
		ПозицияКонцаСтроки = СтрНайти(Сред(Текст, Позиция), ПереводСтроки);
		Если ПозицияКонцаСтроки = 0 Тогда
			СтрокаТекста = Сред(Текст, Позиция);
		Иначе
			СтрокаТекста = Сред(Текст, Позиция, ПозицияКонцаСтроки - 1);
		КонецЕсли;

		Если СокрЛП(СтрокаТекста) = Слово Тогда
			Возврат Позиция;
		КонецЕсли;

		Если ПозицияКонцаСтроки = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Позиция + ПозицияКонцаСтроки - 1 + ДлинаПереводаСтроки;
	КонецЦикла;

	Возврат 0;

КонецФункции

&НаСервере
Функция РШ_ВставитьПослеПервогоВхождения(Текст, Подстрока, СтрокаДляВставки)

	Позиция = СтрНайти(Текст, Подстрока);
	Если Позиция = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	ПозицияВставки = Позиция + СтрДлина(Подстрока);

	Возврат Лев(Текст, ПозицияВставки - 1)
		+ СтрокаДляВставки
		+ Сред(Текст, ПозицияВставки);

КонецФункции

&НаСервере
Функция РШ_ПоследнееВхождение(Текст, Подстрока)

	Позиция = 0;
	ДлинаПодстроки = СтрДлина(Подстрока);
	Индекс = 1;

	Если ДлинаПодстроки = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Пока Индекс <= СтрДлина(Текст) - ДлинаПодстроки + 1 Цикл
		Если Сред(Текст, Индекс, ДлинаПодстроки) = Подстрока Тогда
			Позиция = Индекс;
			Индекс = Индекс + ДлинаПодстроки;
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

&НаСервере
Процедура РШ_ДобавитьКолонкиЗакупочнойЦены()

	РШ_ДобавитьКолонкуЗакупочнойЦены(
		"СписокСтандартныйПоискНоменклатура",
		"СписокСтандартныйПоискНоменклатураЗакупочнаяЦена",
		"СписокНоменклатура.ЗакупочнаяЦена",
		"СписокСтандартныйПоискНоменклатураВНаличииОстаток");

	РШ_ДобавитьКолонкуЗакупочнойЦены(
		"СписокРасширенныйПоискНоменклатура",
		"СписокРасширенныйПоискНоменклатураЗакупочнаяЦена",
		"СписокНоменклатура.ЗакупочнаяЦена",
		"СписокРасширенныйПоискНоменклатураВНаличииОстаток");

	РШ_ДобавитьКолонкуЗакупочнойЦены(
		"СписокСтандартныйПоискХарактеристики",
		"СписокСтандартныйПоискХарактеристикиЗакупочнаяЦена",
		"СписокХарактеристики.ЗакупочнаяЦена",
		"СписокСтандартныйПоискХарактеристикиВНаличииОстаток");

	РШ_ДобавитьКолонкуЗакупочнойЦены(
		"СписокРасширенныйПоискХарактеристики",
		"СписокРасширенныйПоискХарактеристикиЗакупочнаяЦена",
		"СписокХарактеристики.ЗакупочнаяЦена",
		"СписокРасширенныйПоискХарактеристикиВНаличииОстаток");

КонецПроцедуры

&НаСервере
Процедура РШ_ДобавитьКолонкуЗакупочнойЦены(ИмяТаблицы, ИмяКолонки, ПутьКДанным, ИмяКолонкиПеред)

	Если Элементы.Найти(ИмяКолонки) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица = Элементы.Найти(ИмяТаблицы);
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КолонкаПеред = Элементы.Найти(ИмяКолонкиПеред);
	Если КолонкаПеред = Неопределено Тогда
		Колонка = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), Таблица);
	Иначе
		Колонка = Элементы.Вставить(ИмяКолонки, Тип("ПолеФормы"), Таблица, КолонкаПеред);
	КонецЕсли;

	Колонка.Вид = ВидПоляФормы.ПолеНадписи;
	Колонка.ПутьКДанным = ПутьКДанным;
	Колонка.Заголовок = НСтр("ru = 'Закуп. цена'");
	Колонка.Ширина = 12;
	Колонка.Формат = "ЧДЦ=2";

	Попытка
		Колонка.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Право;
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция РШ_НайтиЗакупочныйВидЦены()

	ВариантыНаименований = Новый Массив;
	ВариантыНаименований.Добавить("Закупочная");
	ВариантыНаименований.Добавить("Закупочные");
	ВариантыНаименований.Добавить("Цена закупки");
	ВариантыНаименований.Добавить("Закупочная цена");

	Для Каждого НаименованиеВидаЦены Из ВариантыНаименований Цикл
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию(НаименованиеВидаЦены, Истина);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			Возврат ВидЦены;
		КонецЕсли;
	КонецЦикла;

	Возврат Справочники.ВидыЦен.ПустаяСсылка();

КонецФункции

#КонецОбласти
