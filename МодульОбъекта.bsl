#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьПериодПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьОтчетЗаПериод();
	
КонецПроцедуры

#КонецОбласти

#Область КлиентскиеПроцедуры

&НаКлиенте
Процедура СформироватьОтчетЗаПериод()
	
	Если Не ЗначениеЗаполнено(ДатаОт) Или Не ЗначениеЗаполнено(ДатаДо) Тогда
		Сообщить("Заполните период отчета.");
		Возврат;
	КонецЕсли;
	
	Если НачалоДня(ДатаОт) > НачалоДня(ДатаДо) Тогда
		Сообщить("Дата начала периода больше даты окончания периода.");
		Возврат;
	КонецЕсли;
	
	Попытка
		СформированныйТабличныйДокумент = СформироватьОтчетНаСервере(ДатаОт, ДатаДо);
		СохранитьВыбранныйПериод();
		ПоказатьСформированныйОтчет(СформированныйТабличныйДокумент);
		Сообщить("Отчет сформирован.");
	Исключение
		Сообщить("Не удалось сформировать отчет: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСформированныйОтчет(СформированныйТабличныйДокумент)

	Если Элементы.Найти("ТабличныйДокумент") = Неопределено Тогда
		СформированныйТабличныйДокумент.Показать("Проданные товары в чеках и заказах");
		Возврат;
	КонецЕсли;

	ТабличныйДокумент = СформированныйТабличныйДокумент;

КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)

	Если ТипЗнч(Расшифровка) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ОткрытьСписокНоменклатурыСПозиционированием(Расшифровка);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокНоменклатурыСПозиционированием(Номенклатура)

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекущаяСтрока", Номенклатура);

	Попытка
		ОткрытьФорму("Справочник.Номенклатура.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	Исключение
		Сообщить("Не удалось открыть список номенклатуры: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПериодПоУмолчанию()
	
	Период = ПолучитьПериодПоУмолчаниюНаСервере();
	ДатаОт = Период.ДатаОт;
	ДатаДо = Период.ДатаДо;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВыбранныйПериод()
	
	СохранитьВыбранныйПериодНаСервере(ДатаОт, ДатаДо);
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Функция ПолучитьПериодПоУмолчаниюНаСервере()
	
	ПериодПоУмолчанию = Новый Структура("ДатаОт, ДатаДо", НачалоМесяца(ТекущаяДата()), КонецМесяца(ТекущаяДата()));
	
	Попытка
		Период = ХранилищеОбщихНастроек.Загрузить("ПроданныеТоварыВЧекахИЗаказах", "Период");
	Исключение
		Возврат ПериодПоУмолчанию;
	КонецПопытки;
	
	Если ТипЗнч(Период) = Тип("Структура") Тогда
		Если Период.Свойство("ДатаОт")
			И Период.Свойство("ДатаДо")
			И ЗначениеЗаполнено(Период.ДатаОт)
			И ЗначениеЗаполнено(Период.ДатаДо) Тогда
			Возврат Новый Структура("ДатаОт, ДатаДо", Период.ДатаОт, Период.ДатаДо);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПериодПоУмолчанию;
	
КонецФункции

&НаСервере
Процедура СохранитьВыбранныйПериодНаСервере(ДатаОт, ДатаДо)
	
	Период = Новый Структура("ДатаОт, ДатаДо", ДатаОт, ДатаДо);
	
	Попытка
		ХранилищеОбщихНастроек.Сохранить("ПроданныеТоварыВЧекахИЗаказах", "Период", Период);
	Исключение
		Сообщить("Не удалось сохранить выбранный период отчета: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетНаСервере(ДатаОт, ДатаДо)
	
	ВидЗакупочнойЦены = НайтиЗакупочныйВидЦены();
	ДанныеОтчета = ПолучитьДанныеОтчета(ДатаОт, ДатаДо, ВидЗакупочнойЦены);
	
	Возврат ПолучитьТабличныйДокументОтчета(ДанныеОтчета, ДатаОт, ДатаДо, ВидЗакупочнойЦены);
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеОтчета(ДатаОт, ДатаДо, ВидЗакупочнойЦены = Неопределено)
	
	ПроверитьПериодОтчета(ДатаОт, ДатаДо);
	
	ДатаНачала = НачалоДня(ДатаОт);
	ДатаОкончания = КонецДня(ДатаДо);
	
	Если Не ЗначениеЗаполнено(ВидЗакупочнойЦены) Тогда
		ВидЗакупочнойЦены = НайтиЗакупочныйВидЦены();
	КонецЕсли;
	
	Попытка
		Возврат ВыполнитьЗапросПроданныхТоваров(ДатаНачала, ДатаОкончания, ВидЗакупочнойЦены, "ВНаличииОстаток");
	Исключение
		ПерваяОшибка = ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		Возврат ВыполнитьЗапросПроданныхТоваров(ДатаНачала, ДатаОкончания, ВидЗакупочнойЦены, "КоличествоОстаток");
	Исключение
		ВызватьИсключение "Не удалось сформировать отчет. Проверьте имена документов, регистров и поля остатка в запросе." 
			+ Символы.ПС + "Первая попытка: " + ПерваяОшибка
			+ Символы.ПС + "Вторая попытка: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция НайтиЗакупочныйВидЦены()
	
	ВариантыНаименований = Новый Массив;
	ВариантыНаименований.Добавить("Закупочная");
	ВариантыНаименований.Добавить("Закупочные");
	ВариантыНаименований.Добавить("Цена закупки");
	ВариантыНаименований.Добавить("Закупочная цена");
	
	Для Каждого НаименованиеВидаЦены Из ВариантыНаименований Цикл
		ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию(НаименованиеВидаЦены, Истина);
		Если ЗначениеЗаполнено(ВидЦены) Тогда
			Возврат ВидЦены;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Справочники.ВидыЦен.ПустаяСсылка();
	
КонецФункции

&НаСервере
Процедура ПроверитьПериодОтчета(ДатаОт, ДатаДо)
	
	Если Не ЗначениеЗаполнено(ДатаОт) Тогда
		ВызватьИсключение "Не заполнена дата начала периода.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаДо) Тогда
		ВызватьИсключение "Не заполнена дата окончания периода.";
	КонецЕсли;
	
	Если НачалоДня(ДатаОт) > НачалоДня(ДатаДо) Тогда
		ВызватьИсключение "Дата начала периода больше даты окончания периода.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросПроданныхТоваров(ДатаОт, ДатаДо, ВидЗакупочнойЦены, ИмяПоляОстатка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПроданныхТоваров(ИмяПоляОстатка);
	Запрос.УстановитьПараметр("ДатаОт", ДатаОт);
	Запрос.УстановитьПараметр("ДатаДо", ДатаДо);
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаДо);
	Запрос.УстановитьПараметр("ВидЗакупочнойЦены", ВидЗакупочнойЦены);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаПроданныхТоваров(ИмяПоляОстатка)
	
	Возврат
	"ВЫБРАТЬ
	|	Продажи.Номенклатура КАК Номенклатура,
	|	СУММА(Продажи.Количество) КАК КоличествоПродано
	|ПОМЕСТИТЬ ПроданныеТовары
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЧекиТовары.Номенклатура КАК Номенклатура,
	|		ЧекиТовары.Количество КАК Количество
	|	ИЗ
	|		Документ.ЧекККМ.Товары КАК ЧекиТовары
	|	ГДЕ
	|		ЧекиТовары.Ссылка.Проведен = ИСТИНА
	|		И ЧекиТовары.Ссылка.Дата МЕЖДУ &ДатаОт И &ДатаДо
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЗаказыТовары.Номенклатура,
	|		ЗаказыТовары.Количество
	|	ИЗ
	|		Документ.ЗаказКлиента.Товары КАК ЗаказыТовары
	|	ГДЕ
	|		ЗаказыТовары.Ссылка.Проведен = ИСТИНА
	|		И ЗаказыТовары.Ссылка.Дата МЕЖДУ &ДатаОт И &ДатаДо) КАК Продажи
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказыТовары.Количество) КАК КоличествоЗаказано
	|ПОМЕСТИТЬ ЗаказанныеТовары
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказыТовары
	|ГДЕ
	|	ЗаказыТовары.Ссылка.Проведен = ИСТИНА
	|	И ЗаказыТовары.Ссылка.Дата МЕЖДУ &ДатаОт И &ДатаДо
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки." + ИмяПоляОстатка + ") КАК Остаток
	|ПОМЕСТИТЬ ОстаткиТоваров
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, ) КАК Остатки
	|ГДЕ
	|	Остатки.Номенклатура В
	|		(ВЫБРАТЬ
	|			ПроданныеТовары.Номенклатура
	|		ИЗ
	|			ПроданныеТовары КАК ПроданныеТовары)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(Цены.Цена) КАК ЗакупочнаяЦена
	|ПОМЕСТИТЬ ЗакупочныеЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаОстатков, ВидЦены = &ВидЗакупочнойЦены) КАК Цены
	|ГДЕ
	|	Цены.Номенклатура В
	|		(ВЫБРАТЬ
	|			ПроданныеТовары.Номенклатура
	|		ИЗ
	|			ПроданныеТовары КАК ПроданныеТовары)
	|
	|СГРУППИРОВАТЬ ПО
	|	Цены.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроданныеТовары.Номенклатура.Артикул КАК Артикул,
	|	ПроданныеТовары.Номенклатура КАК Номенклатура,
	|	ПроданныеТовары.КоличествоПродано КАК КоличествоПродано,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОстаткиТоваров.Остаток, 0) - ЕСТЬNULL(ЗаказанныеТовары.КоличествоЗаказано, 0) < 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(ОстаткиТоваров.Остаток, 0) - ЕСТЬNULL(ЗаказанныеТовары.КоличествоЗаказано, 0)
	|	КОНЕЦ КАК Остаток,
	|	ЕСТЬNULL(ЗакупочныеЦены.ЗакупочнаяЦена, 0) КАК ЗакупочнаяЦена
	|ИЗ
	|	ПроданныеТовары КАК ПроданныеТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиТоваров КАК ОстаткиТоваров
	|		ПО ПроданныеТовары.Номенклатура = ОстаткиТоваров.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказанныеТовары КАК ЗаказанныеТовары
	|		ПО ПроданныеТовары.Номенклатура = ЗаказанныеТовары.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗакупочныеЦены КАК ЗакупочныеЦены
	|		ПО ПроданныеТовары.Номенклатура = ЗакупочныеЦены.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
КонецФункции

#КонецОбласти

#Область ВыводОтчета

&НаСервере
Функция ПолучитьТабличныйДокументОтчета(ДанныеОтчета, ДатаОт, ДатаДо, ВидЗакупочнойЦены)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	НастроитьШиринуКолонок(ТабличныйДокумент);
	
	УстановитьТекстЯчейки(ТабличныйДокумент, 1, 1, "Проданные товары в чеках и заказах");
	ОформитьЗаголовокОтчета(ТабличныйДокумент);
	УстановитьТекстЯчейки(ТабличныйДокумент, 2, 1, "Период:");
	УстановитьТекстЯчейки(ТабличныйДокумент, 2, 2, Формат(ДатаОт, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаДо, "ДФ=dd.MM.yyyy"));
	УстановитьТекстЯчейки(ТабличныйДокумент, 3, 1, "Вид закупочной цены:");
	УстановитьТекстЯчейки(ТабличныйДокумент, 3, 2, ПредставлениеВидаЦены(ВидЗакупочнойЦены));
	
	Если ДанныеОтчета.Количество() = 0 Тогда
		УстановитьТекстЯчейки(ТабличныйДокумент, 5, 1, "За выбранный период проведенных чеков и заказов с товарами не найдено.");
		Возврат ТабличныйДокумент;
	КонецЕсли;
	
	НомерСтроки = 5;
	ВывестиСтрокуШапки(ТабличныйДокумент, НомерСтроки);
	ОформитьШапкуТаблицы(ТабличныйДокумент, НомерСтроки);
	
	Для Каждого СтрокаДанных Из ДанныеОтчета Цикл
		НомерСтроки = НомерСтроки + 1;
		ВывестиСтрокуТовара(ТабличныйДокумент, НомерСтроки, СтрокаДанных);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаСервере
Процедура НастроитьШиринуКолонок(ТабличныйДокумент)
	
	УстановитьШиринуКолонки(ТабличныйДокумент, 1, 18);
	УстановитьШиринуКолонки(ТабличныйДокумент, 2, 45);
	УстановитьШиринуКолонки(ТабличныйДокумент, 3, 16);
	УстановитьШиринуКолонки(ТабличныйДокумент, 4, 16);
	УстановитьШиринуКолонки(ТабличныйДокумент, 5, 18);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуШапки(ТабличныйДокумент, НомерСтроки)
	
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 1, "Артикул");
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 2, "Номенклатура");
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 3, "Продано");
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 4, "Остаток");
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 5, "Закупочная цена");
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокуТовара(ТабличныйДокумент, НомерСтроки, СтрокаДанных)
	
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 1, Строка(СтрокаДанных.Артикул));
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 2, Строка(СтрокаДанных.Номенклатура));
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 3, ФорматЧисла(СтрокаДанных.КоличествоПродано));
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 4, ФорматЧисла(СтрокаДанных.Остаток));
	УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, 5, ФорматЧисла(СтрокаДанных.ЗакупочнаяЦена));
	
	// Привязываем ячейку "Номенклатура" к самой ссылке товара
	ЯчейкаНоменклатуры = ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 2);
	ЯчейкаНоменклатуры.Расшифровка = СтрокаДанных.Номенклатура;
	
КонецПроцедуры

&НаСервере
Процедура ОформитьЗаголовокОтчета(ТабличныйДокумент)
	
	ОбластьЗаголовка = ТабличныйДокумент.Область(1, 1, 1, 5);
	ОбластьЗаголовка.Объединить();
	ОбластьЗаголовка.Шрифт = Новый Шрифт(ОбластьЗаголовка.Шрифт, , 14, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОформитьШапкуТаблицы(ТабличныйДокумент, НомерСтроки)
	
	ОбластьШапки = ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 5);
	ОбластьШапки.Шрифт = Новый Шрифт(ОбластьШапки.Шрифт, , , Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки, ТекстЯчейки)
	
	ОбластьЯчейки = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	ОбластьЯчейки.Текст = ТекстЯчейки;
	УстановитьГраницыЯчейки(ОбластьЯчейки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГраницыЯчейки(ОбластьЯчейки)
	
	ЛинияГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	ОбластьЯчейки.ГраницаСлева = ЛинияГраницы;
	ОбластьЯчейки.ГраницаСверху = ЛинияГраницы;
	ОбластьЯчейки.ГраницаСправа = ЛинияГраницы;
	ОбластьЯчейки.ГраницаСнизу = ЛинияГраницы;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьШиринуКолонки(ТабличныйДокумент, НомерКолонки, ШиринаКолонки)
	
	ОбластьКолонки = ТабличныйДокумент.Область(1, НомерКолонки, 1, НомерКолонки);
	ОбластьКолонки.ШиринаКолонки = ШиринаКолонки;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеВидаЦены(ВидЗакупочнойЦены)
	
	Если ЗначениеЗаполнено(ВидЗакупочнойЦены) Тогда
		Возврат Строка(ВидЗакупочнойЦены);
	КонецЕсли;
	
	Возврат "не найден, цена будет 0";
	
КонецФункции

&НаСервере
Функция ФорматЧисла(Значение)
	
	ПредставлениеЧисла = Формат(Значение, "ЧДЦ=3; ЧГ=0");
	
	Пока ЕстьДробнаяЧастьВПредставлении(ПредставлениеЧисла)
		И Прав(ПредставлениеЧисла, 1) = "0" Цикл
		ПредставлениеЧисла = Лев(ПредставлениеЧисла, СтрДлина(ПредставлениеЧисла) - 1);
	КонецЦикла;
	
	Если ЕстьДробнаяЧастьВПредставлении(ПредставлениеЧисла)
		И (Прав(ПредставлениеЧисла, 1) = "," Или Прав(ПредставлениеЧисла, 1) = ".") Тогда
		ПредставлениеЧисла = Лев(ПредставлениеЧисла, СтрДлина(ПредставлениеЧисла) - 1);
	КонецЕсли;
	
	Возврат ПредставлениеЧисла;
	
КонецФункции

&НаСервере
Функция ЕстьДробнаяЧастьВПредставлении(ПредставлениеЧисла)
	
	Возврат СтрНайти(ПредставлениеЧисла, ",") > 0 Или СтрНайти(ПредставлениеЧисла, ".") > 0;
	
КонецФункции

